# Allow-list: only the files named below are published. Everything else (data/, archive/, .env, temp folders) stays local.
/*
!/.gitignore
!/README.md
!/DIARY.md
!/CLAUDE.md
!/START_HERE.md
!/HANDOFF_CURRENT.md
!/HANDOFF_ASTRA.md
!/PLAYBOOK.md
!/RULES.md
!/RUNBOOK.md
!/INSIGHTS.md
!/MISTAKES.md
!/LOG.md
!/JOURNAL.md
!/RESEARCH_LOG.md
!/requirements.txt
!/run.py
!/netlify.toml
!/start_astra.ps1
!/stalk/
!/web/
!/scripts/
!/tests/
!/docs/
!/snapshot/
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/launch.json

# Never, anywhere
.env
.env.*
*.env
__pycache__/
*.pyc
*.pkl
*.npy
*.db
*.sqlite*
*.parquet
*.jsonl
*.log
.claude/settings.local.json
